# Copy this file to .env and fill in the values

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_secret

# Token encryption key for platform OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me_generate_a_fernet_key

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# SQLite database path (default: ./creator_sync.db)
DATABASE_URL=sqlite:///./creator_sync.db

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Twitter / X OAuth 2.0 credentials
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Instagram / Facebook credentials
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# YouTube / Google credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok credentials
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Environment: development | production
ENV=development
